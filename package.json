{
  "name": "askmeajoke-projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n ui,lg,agno -c blue,magenta,green \"pnpm dev:ui\" \"pnpm dev:langgraph\" \"pnpm dev:agno\"",
    "dev:ui": "next dev --turbopack --port 3100",
    "dev:langgraph": "cd agents/langgraph && (command -v uv >/dev/null && uv run langgraph dev --port 8123 --no-browser || .venv/bin/langgraph dev --port 8123 --no-browser)",
    "dev:agno": "cd agents/agno && (command -v uv >/dev/null && uv run python main.py || .venv/bin/python main.py)",
    "setup:agents": "bash scripts/setup-python-agents.sh",
    "build": "next build",
    "start": "next start --port 3100",
    "check-types": "tsc --noEmit",
    "smoke": "bash scripts/smoke-test.sh",
    "test:e2e": "playwright test",
    "preflight": "bash scripts/preflight-demo.sh"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@copilotkit/a2ui-renderer": "1.75.2",
    "@copilotkit/react-core": "1.75.2",
    "@copilotkit/runtime": "1.75.2",
    "@copilotkit/shared": "1.75.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.476.0",
    "next": "16.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "rxjs": "7.8.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.1.8",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
