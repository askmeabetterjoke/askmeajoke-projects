# Primary: OpenAI
OPENAI_API_KEY=your_openai_api_key
COPILOTKIT_MODEL=openai/gpt-5-mini

# Force OpenCode when OpenAI quota is exhausted (optional)
# COPILOTKIT_LLM_PROVIDER=opencode

# Fallback: OpenCode Zen (used when OPENAI_API_KEY is unset, or provider=opencode)
# OPENCODE_API_KEY=your_opencode_api_key
# OPENCODE_MODEL=qwen3.8-max
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Remote agents (LangGraph analytics + Agno documents)
# Local dev:
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
AGENT_URL=http://localhost:8000
#
# Production on Vercel (see docs/DEPLOYMENT_HOSTING.md):
# - LangGraph Cloud: LANGGRAPH_DEPLOYMENT_URL=https://<langsmith-deployment-url>
# - LangSmith API key for CopilotKit LangGraphAgent:
# LANGSMITH_API_KEY=lsv2_...
# - Analytics without hosting LangGraph (OpenAI only, runs on Vercel):
# LANGGRAPH_DEPLOYMENT_URL=builtin
# - Agno: deploy AgentOS (Railway/AWS/Fly/etc.), NOT os.agno.com alone:
# AGENT_URL=https://<your-public-agentos-host>
# Agno documents agent (default gpt-4o-mini — lower token use than gpt-4o)
# AGNO_MODEL=gpt-4o-mini
# LANGSMITH_API_KEY=
# LANGGRAPH_MODEL=gpt-4o-mini
